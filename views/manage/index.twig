{% extends 'layouts/logged_in.twig' %}

{% block page_content %}

<div class="align-items-center d-md-flex justify-content-between">
  <h1 class="h2 mb-4">
    {{title}}
  </h1>
  {{ include('shared/_search_form.twig') }}
</div>
{% if search_term and search_result_count > 0 %}
  <p>
    Found {{search_result_count}} result{% if search_result_count != 1 %}s{% endif %} for "{{search_term}}"
  </p>
{% endif %}

<nav>
  <div class="nav nav-tabs my-meetings-nav-tabs" role="tablist">
    <a class="nav-item nav-link active" id="meetings-tab" data-toggle="tab" href="#meetings" role="tab" aria-controls="meetings" aria-selected="true">
      Meetings ({{ meetings | count }})
    </a>
    <a class="nav-item nav-link" id="find-a-times-tab" data-toggle="tab" href="#find-a-times" role="tab" aria-controls="find-a-times" aria-selected="false">
      Find-a-Times ({{ find_a_times | count }})
    </a>
  </div>
</nav>

<div class="tab-content">
  <div class="tab-pane fade show active" id="meetings" role="tabpanel" aria-labelledby="meetings-tab">
    {% if meetings %}
      <table class="table">
        <thead>
          <tr class="d-flex">
            <th class="col-2 border-top-0">Title</th>
            <th class="col-2 border-top-0">Location</th>
            <th class="col-2 border-top-0">Dates</th>
            <th class="col-2 border-top-0">Reservations Remaining</th>
            <th class="col-2 border-top-0">Invite Link</th>
            <th class="col-2 border-top-0">Last Modified</th>
          </tr>
        </thead>
        <tbody>
          {% for meeting in meetings %}
            <tr class="d-flex">
              <td class="col-2">
                <a href="{{site_url}}/meetings/{{meeting.id}}">{{meeting.name}}</a>
              </td>
              <td class="col-2">
                {{meeting.location}}
              </td>
              <td class="col-2">
                {% for date in meeting.dates %}
                  {{date.date | date("n/j/y")}}{% if loop.index != meeting.dates_count %}, {% endif %}
                {% endfor %}
              </td>
              <td class="col-2">
                {{meeting.open_slots}} of {{meeting.capacity}}
              </td>
              <td class="col-2">
                <button class="btn btn-secondary btn-sm copy-btn" data-link="{{site_url}}/invite?key={{meeting.hash}}">
                  <i class="fas fa-clipboard"></i> Copy
                </button>
              </td>
              <td class="col-2">
                {{meeting.mod_date | date("n/j/y g:ia T (\\G\\M\\T P)", user_timezone)}}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      {% if search_term %}
        <p class="mt-3">No results found</p>
      {% else %}
        <p class="mt-3">Nothing here yet! Want to <a href="{{site_url}}/meetings/create">create a meeting</a>?</p>
      {% endif %}
    {% endif %}
  </div>
  <div class="tab-pane fade" id="find-a-times" role="tabpanel" aria-labelledby="find-a-times-tab">
    {% if find_a_times %}
      <table class="table">
        <thead>
          <tr class="d-flex">
            <th class="col border-top-0">Title</th>
            <th class="col-2 border-top-0">Invite Link</th>
            <th class="col-2 border-top-0">Last Modified</th>
          </tr>
        </thead>
        <tbody>
          {% for find_a_time in find_a_times %}
            <tr class="d-flex">
              <td class="col">
                <a href="{{site_url}}/schedule/{{find_a_time.id}}">{{find_a_time.name}}</a>
              </td>
              <td class="col-2">
                <button class="btn btn-secondary btn-sm copy-btn" data-link="{{site_url}}/schedule/invite?key={{find_a_time.hash}}">
                  <i class="fas fa-clipboard"></i> Copy
                </button>
              </td>
              <td class="col-2">
                {{find_a_time.mod_date | date("n/j/y g:ia T (\\G\\M\\T P)", user_timezone)}}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      {% if search_term %}
        <p class="mt-3">No results found</p>
      {% else %}
        <p class="mt-3">Nothing here yet! Want to <a href="{{site_url}}/schedule/create">create a find-a-time</a>?</p>
      {% endif %}
    {% endif %}
  </div>
</div>

{% endblock %}
