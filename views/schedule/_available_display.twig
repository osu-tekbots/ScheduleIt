<div class="mb-2">
  <label class="h6 mb-3">
      Others' Availabilities
  </label>
  <div class="d-flex">
    <div class="times-selector-legend-container">
      <ul class="d-flex list-unstyled">
        <li id="times-selector-legend">
          {% for time in time_labels[0] %}
            <div class="times-label">
              {{time | date("g:i a T", user_timezone)}}
            </div>
          {% endfor %}

          {% if time_labels[0] is not empty %}
            <div class="times-label-spacer"></div>
          {% endif %}
          
          {% for time in time_labels[1] %}
            <div class="times-label">
              {{time | date("g:i a T", user_timezone)}}
            </div>
          {% endfor %}
        </li>
      </ul>
    </div>

    <div class="times-selector-container">
      <ul class="d-flex list-unstyled" >
        <li class="times-selector-placeholder {% if dates %}d-none{% endif %}">
          Select dates first.
        </li>
        {% if dates %}
        {% for date in dates %}
          <li>
            <h4 class="date-label mb-0 text-center">
              {{date | date("D, M j")}}
            </h4>
            {% for time in time_labels[0] %}
              {% if timeslots[date][time].is_valid %}
                <label
                  onmouseover='showGroupAvailability("{{timeslots[date][time].formatted_date}}", {{timeslots[date][time].available | json_encode | raw}});' onmouseleave="showTimeSelector()"
                  class="times-label {% if timeslots[date][time].available | length > 0 %}times-label--checked times-label--checked-confirm"
                  style="background-color:green;opacity:{{(((timeslots[date][time].available | length) * 100) // schedule.users_count)}}%; {% endif %}">
                  {{time}}
                  <input>
                </label>
              {% else %}
                <label class="times-label times-label--disabled">
                  <input disabled>
                </label>
              {% endif %}
            {% endfor %}

            {% if time_labels[0] is not empty %}
              <div class="times-label-spacer"></div>
            {% endif %}

            {% for time in time_labels[1] %}
              {% if timeslots[date][time].is_valid %}
                <label
                  onmouseover='showGroupAvailability("{{timeslots[date][time].formatted_date}}", {{timeslots[date][time].available | json_encode | raw}});' onmouseleave="showTimeSelector()"
                  class="times-label {% if timeslots[date][time].available | length > 0 %}times-label--checked times-label--checked-confirm"
                  style="background-color:green;opacity:{{(((timeslots[date][time].available | length) * 100) // schedule.users_count)}}%; {% endif %}">
                  {{time}}
                  <input>
                </label>
              {% else %}
                <label class="times-label times-label--disabled">
                  <input disabled>
                </label>
              {% endif %}
            {% endfor %}
          </li>
        {% endfor %}
        {% endif %}
      </ul>
    </div>
  </div>
</div>

<script>
  function showTimeSelector() {
    $("#myTimeSelector").show();
    $("#groupAvailability").hide();
    $('#time_display_group_availability').text("");
    $('#available_users_group_availability').text("");
    $('#unavailable_users_group_availability').text("");
  };


  function showGroupAvailability(date_time, available_users) {
    $("#myTimeSelector").hide();
    $("#groupAvailability").show();

    const total_users = {{usernames | json_encode | raw}};

    available_users.forEach((available_user) => {
        if (available_user != "") {
            $('#available_users_group_availability').append(available_user + "<br>");
        }
    });

    total_users.forEach((user) => {
        if (user != "") {
            if (!available_users.includes(user)) {
                $('#unavailable_users_group_availability').append(user + "<br>");
            }
        }
    });

    $('#time_display_group_availability').text(date_time);
    $('#ratio_of_group_availability').text(available_users.length + "/" + total_users.length + " Available")
  };
</script>