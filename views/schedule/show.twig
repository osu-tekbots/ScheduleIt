{% extends 'layouts/logged_in.twig' %}

{% block page_content %}

<h1 class="h2 mb-4">
  {{title}}
</h1>

<div class="card mb-4 card-mine">
  <div class="card-body pb-0">
    <div class="row">
      <div class="col-6">
        <h4 class="h6 mb-1">
          Title
        </h4>
        <p class="card-text-large">
          {{schedule.name}}
        </p>
        <h4 class="h6 mb-1">
          Description
        </h4>
        <p class="card-text-large">
          {{schedule.description}}
        </p>
        <h4 class="h6 mb-1">
          Dates
        </h4>
        <p class="card-text-large">
          {% if dates %}
          {% for date in dates %}
            {% if (loop.index == 1) or (loop.index == schedule.dates_count) %}
              {% if loop.index != 1 %} to {% endif %}{{date.date | date("n/j/y")}}
            {% endif %}
          {% endfor %}
          {% endif %}
        </p>
        <h4 class="h6 mb-1">
          Users
        </h4>
        <p class="card-text-large">
          {{schedule.users_count}}
        </p>
        <h4 class="h6 mb-1">
          Anonymous Meeting
        </h4>
        <p class="card-text-large">
          {% if schedule.is_anon == true %}
            Yes
          {% else %}
            No
          {% endif %}
        </p>
      </div>
      <div class="col-6">
        <p class="card-text-large">
          <a id="inviteLink" href="{{site_url}}/schedule/invite?key={{schedule.hash}}">Invite Link</a>
        </p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-6">
    {{ include('schedule/_available_display_show_page.twig') }}
  </div>
  <div class="col-6" style="text-align: center;">
    {% if timeslot %}
    <h1 class="h2 mb-4">
    {{number_available}}/{{schedule.users_count}} Available
    </h1>
    <label class="h6 mb-3">
    {{ date(timeslot)|date('l, M d Y h:i:s A ') }} PST
    </label>
    <br>
    <div class="row">
      <div class="col-6">
      <label class="h6 mb-3">
      Available
      </label>
      {% if available_users %}
        {% for available_user in available_users %}
          <br>
          {{available_user}}
        {% endfor %}
      {% endif %}
      </div>
      <div class="col-6">
      <label class="h6 mb-3">
      Unavailable
      </label>
      {% if not_available_users %}
        {% for not_available_user in not_available_users %}
          <br>
          {{not_available_user}}
        {% endfor %}
      {% endif %}
      </div>
    </div>
    {% endif %}
  </div>

{% endblock %}
