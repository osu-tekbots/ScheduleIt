{% extends 'layouts/logged_in.twig' %}

{% block page_content %}

<h1 class="h2 mb-4">
  {{title}}
</h1>
<div class="row">
<div class="card mb-4 card-mine col-lg-6">
  <div class="card-body pb-0">
    <div class="row">
      <div class="col-12">
        <h4 class="h6 mb-1">
          Title
        </h4>
        <p class="card-text-large">
          {{schedule.name}}
        </p>
        <h4 class="h6 mb-1">
          Description
        </h4>
        <p class="card-text-large">
          {{schedule.description}}
        </p>
        <h4 class="h6 mb-1">
          Dates
        </h4>
        <p class="card-text-large">
          {% if dates %}
          {% for date in dates %}
            {% if (loop.index == 1) or (loop.index == schedule.dates_count) %}
              {% if loop.index != 1 %} to {% endif %}{{date.date | date("n/j/y")}}
            {% endif %}
          {% endfor %}
          {% endif %}
        </p>
        <h4 class="h6 mb-1">
          Users
        </h4>
        <p class="card-text-large">
          {{schedule.users_count}}
        </p>
        <h4 class="h6 mb-1">
          Anonymous Meeting
        </h4>
        <p class="card-text-large">
          {% if schedule.is_anon == true %}
            Yes
          {% else %}
            No
          {% endif %}
        </p>
        <p class="card-text-large">
          <a id="inviteLink" href="{{site_url}}/schedule/invite?key={{schedule.hash}}">Invite Link</a>
        </p>
      </div>
    </div>
  </div>
</div>
  <div id="groupAvailability" class="col-lg-6" style="display: none; text-align: center;">
    <div id="groupAvailabilityShow" class="col-lg-4">
        <h1 id="ratio_of_group_availability" class="h2 mb-4">
            
        </h1>
        <label id="time_display_group_availability" class="h6 mb-3">

        </label>
        <br>
        <div class="row">
          <div class="col-6">
              <label class="h6 mb-3">
              Available
              </label>
              <p id="available_users_group_availability">
              </p>
          </div>
          <div class="col-6">
              <label class="h6 mb-3">
              Unavailable
              </label>
              <p id="unavailable_users_group_availability">
              </p>
          </div>
        </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-6 col-10">
    {{ include('schedule/_available_display_show_page.twig') }}
  </div>
  <div id="myTimeSelector" class="col-6" style="display: inline-block;"> 

  </div>
</div>

<script>
  function showGroupAvailability(date_time, available_users_string) {
    $("#myTimeSelector").hide();
    $("#groupAvailability").show();

    const total_users_string = "{{usernames}}";
    const total_users = total_users_string.split("/");

    const available_users = available_users_string.split("/");
    let available_count = 0;
    available_users.forEach((available_user) => {
        if (available_user != "") {
            $('#available_users_group_availability').append(available_user + "<br>");
            available_count ++;
        }
    });

    let total_count = 0;
    total_users.forEach((user) => {
        if (user != "") {
            if (!available_users.includes(user)) {
                $('#unavailable_users_group_availability').append(user + "<br>");
            }
            total_count ++;
        }
    });

    const date_time_display = new Date(date_time);
    const formattedDate = date_time_display.toLocaleString("en-US", {
        weekday: "long", 
        month: "short", 
        day: "2-digit", 
        year: "numeric", 
        hour: "2-digit", 
        minute: "2-digit", 
        second: "2-digit", 
        timeZoneName: "short",
        hour12: true
    });

    $('#time_display_group_availability').text(formattedDate);
    $('#ratio_of_group_availability').text(available_count + "/" + total_count + " Available")
  };
  function showTimeSelector() {
    $("#myTimeSelector").show();
    $("#groupAvailability").hide();
    $('#time_display_group_availability').text("");
    $('#available_users_group_availability').text("");
    $('#unavailable_users_group_availability').text("");
  };
</script>

{% endblock %}
