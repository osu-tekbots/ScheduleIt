{% extends 'layouts/logged_in.twig' %}

{% block page_content %}

<h1 class="h2 mb-4">
  {{title}}
</h1>
<div class="row">
<div class="card mb-4 card-mine col-lg-6">
  <div class="card-body pb-0">
    <div class="row">
      <div class="col-12">
        <h4 class="h6 mb-1">
          Title
        </h4>
        <p class="card-text-large">
          {{schedule.name}}
        </p>
        <h4 class="h6 mb-1">
          Description
        </h4>
        <p class="card-text-large">
          {{schedule.description}}
        </p>
        <h4 class="h6 mb-1">
          Dates
        </h4>
        <p class="card-text-large">
          {% if dates %}
          {% for date in dates %}
            {% if (loop.index == 1) or (loop.index == schedule.dates_count) %}
              {% if loop.index != 1 %} to {% endif %}{{date | date("n/j/y")}}
            {% endif %}
          {% endfor %}
          {% endif %}
        </p>
        <h4 class="h6 mb-1">
          Users
        </h4>
        <p class="card-text-large">
          {{schedule.users_count}}
        </p>
        <h4 class="h6 mb-1">
          Anonymous Meeting
        </h4>
        <p class="card-text-large">
          {% if schedule.is_anon == true %}
            Yes
          {% else %}
            No
          {% endif %}
        </p>
        <div class="row">
          <div class="col-sm-6">
            <p class="card-text-large">
              <a id="inviteLink" href="{{site_url}}/schedule/invite?key={{schedule.hash}}">Invite Link</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
  <div id="groupAvailability" class="col-lg-6" style="display: none; text-align: center;">
    <div id="groupAvailabilityShow" class="col-lg-4">
        <h1 id="ratio_of_group_availability" class="h2 mb-4">
            
        </h1>
        <label id="time_display_group_availability" class="h6 mb-3">

        </label>
        <br>
        <div class="row">
          <div class="col-6">
              <label class="h6 mb-3">
              Available
              </label>
              <p id="available_users_group_availability">
              </p>
          </div>
          <div class="col-6">
              <label class="h6 mb-3">
              Unavailable
              </label>
              <p id="unavailable_users_group_availability">
              </p>
          </div>
        </div>
    </div>
  </div>
</div>

<p class="mb-5">
  <a class="btn btn-primary" href="{{site_url}}/schedule/invite?key={{schedule.hash}}">
    <i class="fas fa-calendar-alt"></i>
    Edit Availability
  </a>
  <button class="btn btn-outline-danger ml-3" type="button" data-toggle="modal" data-target="#delete-findatime-modal">
    <i class="fas fa-trash"></i>
    Delete Find-a-Time
  </button>
</p>

<div class="row">
  <div class="col-lg-6 col-10">
    {{ include('schedule/_available_display.twig') }}
  </div>
  <div id="myTimeSelector" class="col-6" style="display: inline-block;"> 

  </div>
</div>

<div class="modal fade" id="delete-findatime-modal" tabindex="-1" role="dialog" aria-labelledby="delete-findatime-modal-label" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="delete-findatime-modal-label">Delete Find-a-Time</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete this find-a-time?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <form method="post">
          <input type="hidden" name="deleteId" value="{{schedule.id}}">
          <button class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

{% endblock %}
