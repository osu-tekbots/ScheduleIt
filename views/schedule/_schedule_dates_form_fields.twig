<div class="mb-4">
  <label class="h6">
    Timeslot Duration
  </label>
  <p class="text-danger">
    <i class="fas fa-exclamation-circle text-danger"></i>
    Changing this value will cause all selected times to be removed.
  </p>
  <div class="row">
    <div class="col-6 col-md-2">
      <select class="custom-select" id="duration" name="duration" data-create="{% if edit_dates %}false{% else %}true{% endif %}" data-saved-duration="{{schedule.slot_duration}}">
        <option value="60" {% if schedule.slot_duration == 60 %}selected{% endif %}>
          1 hour
        </option>
        <option value="30" {% if schedule.slot_duration == 30 %}selected{% endif %}>
          30 minutes
        </option>
      </select>
    </div>
  </div>
</div>
<div class="mb-4">
  <label class="h6">
    Meeting Time Range
  </label>
  <p class="text-info">
    <i class="fas fa-info-circle"></i>
    Values must be between {{ meetings_min_start_time | date('h:i a T (\\G\\M\\T P)', user_timezone) }}
    and {{ meetings_max_end_time | date('h:i a T (\\G\\M\\T P)', user_timezone) }}
  </p>
  <div class="d-flex align-items-center">
    <div class="col-lg-1 col-2"> 
      <label>
        From
      </label>
    </div>
    <div class="col-2"> 
      <select class="custom-select" id="start-time" name="start-time">
        {% for time in range(meetings_min_start_time|date('U'), meetings_max_end_time|date('U'), 3600) %}
          <option value="{{time|date('H:i P', user_timezone)}}" {% if meetings_start_time|date('U') == time %}selected{% endif %}>
            {{ time | date('h:i a T (\\G\\M\\T P)', user_timezone) }}
          </option>
        {% endfor %}
      </select>
    </div>
    <div class="col-lg-1 col-2"> 
    </div>
    <div class="col-lg-1 col-2"> 
      <label>
        To
      </label>
    </div>
    <div class="col-2"> 
      <select class="custom-select" id="end-time" name="end-time">
        {% for time in range(meetings_min_start_time|date('U'), meetings_max_end_time|date('U'), 3600) %}
          <option value="{{time|date('H:i P', user_timezone)}}" {% if meetings_end_time|date('U') == time %}selected{% endif %}>
            {{ time | date('h:i a T (\\G\\M\\T P)', user_timezone) }}
          </option>
        {% endfor %}
      </select>
    </div>
  </div>
</div>
<div class="mb-4">
  <label class="h6">
    Select Meeting Dates
  </label>
  <p class="text-danger">
    <i class="fas fa-exclamation-circle"></i>
    Times may show unexpectedly when dates cross a daylight savings time boundary.
  </p>
  {% if edit_dates %}
    <p class="text-danger">
      <i class="fas fa-exclamation-circle text-danger"></i>
      Previously saved dates require confirmation for removal.
    </p>
  {% endif %}
  <div
    class="times-selector"
    data-create="{% if edit_dates %}false{% else %}true{% endif %}"
    data-dates="{{dates_json}}"
    data-dates-saved="{{dates_saved_json}}"
    data-end-time="{{meetings_end_time|date('H:i', user_timezone)}}"
    data-start-time="{{meetings_start_time|date('H:i', user_timezone)}}"
    data-max-end-time="{{meetings_max_end_time|date('H:i', user_timezone)}}"
    data-min-start-time="{{meetings_min_start_time|date('H:i', user_timezone)}}"
    id="calendar-times-selector"
  >
  </div>
</div>

{{ include('schedule/_available_selector.twig') }}
