<div class="mb-2">
  <label class="h6 mb-3">
    Select Your Available Times
  </label>
  <p>
    Hold your mouse down to select or deselect multiple times at once.<br>
  </p>
  <div class="d-flex">
    <div class="times-selector-legend-container">
      <ul class="d-flex list-unstyled">
        <li id="times-selector-legend">
          {% for time in time_labels[0] %}
            <div class="times-label">
              {{time | date("g:i a T", user_timezone)}}
            </div>
          {% endfor %}

          {% if time_labels[0] is not empty %}
            <div class="times-label-spacer"></div>
          {% endif %}

          {% for time in time_labels[1] %}
            <div class="times-label times-label-{{time}}" id="{{time}}">
              {{time | date("g:i a T", user_timezone)}}
            </div>
          {% endfor %}
        </li>
      </ul>
    </div>
    <div class="times-selector-container">
      <ul class="d-flex list-unstyled" id="times-selector" data-drag-active="false" data-drag-start-cell="true">
        <li class="times-selector-placeholder {% if dates %}d-none{% endif %}">
          Select dates first.
        </li>
        {% if dates %}
        {% for date in dates %}
          <li class="time-selector-list-item" id="time-{{date}}">
            <input name="date_vals[]" value="{{date}}" type="hidden">
            <h4 class="date-label mb-0 text-center">
              {{date | date("D, M j")}}
            </h4>
            {% for time in time_labels[0] %}
              {% if timeslots[date][time].is_valid %}
                {% set yesterday = date | date_modify("-1 day") | date("Y-m-d") %}
                {% set date_time = "#{yesterday} #{time}" %}
                <label
                  class="times-label times-label-{{time}} {% if date_time in timeslot_times_scheduled %}times-label--checked times-label--checked-confirm{% endif %}"
                  data-meetings-datetime-label="{{date_time}}"
                  {% if date_time in timeslot_times_scheduled %}data-meetings-datetime-label-confirm="{{date_time}}"{% endif %}
                  id="{{date_time}}"
                >
                  <input
                    {% if date_time in timeslot_times_scheduled %}checked{% endif %}
                    {% if date_time in timeslot_times_scheduled %}data-meetings-datetime-confirm="{{date_time}}"{% endif %}
                    data-meetings-datetime="{{date_time}}"
                    name="timeslots[]"
                    type="checkbox"
                    value="{{date_time}}"
                  >
                  {{time}}
                </label>
              {% else %}
                <label class="times-label times-label-{{time}} times-label--disabled">
                  <input disabled>
                </label>
              {% endif %}
            {% endfor %}

            {% if time_labels[0] is not empty %}
              <div class="times-label-spacer"></div>
            {% endif %}

            {% for time in time_labels[1] %}
              {% if timeslots[date][time].is_valid %}
                {% set date_time = "#{date} #{time}" %}
                <label
                  class="times-label times-label-{{time}} {% if date_time in timeslot_times_scheduled %}times-label--checked times-label--checked-confirm{% endif %}"
                  data-meetings-datetime-label="{{date_time}}"
                  {% if date_time in timeslot_times_scheduled %}data-meetings-datetime-label-confirm="{{date_time}}"{% endif %}
                  id="{{date_time}}"
                >
                  <input
                    {% if date_time in timeslot_times_scheduled %}checked{% endif %}
                    {% if date_time in timeslot_times_scheduled %}data-meetings-datetime-confirm="{{date_time}}"{% endif %}
                    data-meetings-datetime="{{date_time}}"
                    name="timeslots[]"
                    type="checkbox"
                    value="{{date_time}}"
                  >
                  {{time}}
                </label>
              {% else %}
                <label class="times-label times-label-{{time}} times-label--disabled">
                  <input disabled>
                </label>
              {% endif %}
            {% endfor %}
          </li>
        {% endfor %}
        {% endif %}
      </ul>
    </div>
  </div>
</div>
