<div class="mb-2">
  <label class="h6 mb-3">
    Select Your Available Times
  </label>
  <p>
    Hold your mouse down to select or deselect multiple times at once.<br>
  </p>
  <div class="d-flex">
    <div class="times-selector-legend-container">
      <ul class="d-flex list-unstyled">
        <li id="times-selector-legend">
          {% for label_group in time_labels %}
            {% for time in label_group %}
              <div class="times-label times-label-{{time|date('H:i:s', user_timezone)}}" id="{{time|date('H:i:s', user_timezone)}}">
                {{time | date("g:i a T", user_timezone)}}
              </div>
            {% endfor %}

            {% if label_group is not empty and not loop.last %}
              <div class="times-label-spacer"></div>
            {% endif %}
          {% endfor %}
        </li>
      </ul>
    </div>
    <div class="times-selector-container">
      <ul class="d-flex list-unstyled" id="times-selector" data-drag-active="false" data-drag-start-cell="true">
        <li class="times-selector-placeholder {% if dates %}d-none{% endif %}">
          Select dates first.
        </li>
        {% if dates %}
        {% for date in dates %}
          <li class="time-selector-list-item" id="time-{{date}}">
            <input name="date_vals[]" value="{{date}}" type="hidden">
            <h4 class="date-label mb-0 text-center">
              {{date | date("D, M j")}}
            </h4>
            {% for label_group in time_labels %}
              {% for time in label_group %}
                {% if timeslots[date][time|date('H:i:s', user_timezone)] is defined %}
                  {% set date_time = "#{date} #{time|date('H:i:s', user_timezone)}" %}
                  <label
                    class="times-label times-label-{{time|date('H:i:s', user_timezone)}} {% if date_time in timeslot_times_scheduled|map(d => d|date('Y-m-d H:i:s', user_timezone)) %}times-label--checked times-label--checked-confirm{% endif %}"
                    data-meetings-datetime-label="{{date_time}}"
                    {% if date_time in timeslot_times_scheduled|map(d => d|date('Y-m-d H:i:s', user_timezone)) %}data-meetings-datetime-label-confirm="{{date_time}}"{% endif %}
                    id="{{date_time}}"
                  >
                    <input
                      {% if date_time in timeslot_times_scheduled|map(d => d|date('Y-m-d H:i:s', user_timezone)) %}checked{% endif %}
                      {% if date_time in timeslot_times_scheduled|map(d => d|date('Y-m-d H:i:s', user_timezone)) %}data-meetings-datetime-confirm="{{date_time}}"{% endif %}
                      data-meetings-datetime="{{date_time}}"
                      name="timeslots[]"
                      type="checkbox"
                      value="{{date}}T{{time|date('H:i:sP', user_timezone)}}"
                    >
                    {{time|date('H:i:s', user_timezone)}}
                  </label>
                {% else %}
                  <label class="times-label times-label-{{time|date('H:i:s', user_timezone)}} times-label--disabled">
                    <input disabled>
                  </label>
                {% endif %}
              {% endfor %}

              {% if label_group is not empty and not loop.last %}
                <div class="times-label-spacer"></div>
              {% endif %}
            {% endfor %}
          </li>
        {% endfor %}
        {% endif %}
      </ul>
    </div>
  </div>
</div>

<script>TIMEZONE = '{{ user_timezone }}';</script>
