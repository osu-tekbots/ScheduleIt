<div class="mb-2">
    <label class="h6 mb-3">
        Other's Availabilities
    </label>
    <p>
        <br>
    </p>
  <div class="d-flex">
    <div class="times-selector-legend-container">
      <ul class="d-flex list-unstyled">
        <li id="times-selector-legend">
          {% for time in time_labels %}
            <div class="times-label">
              {{time | date("g:i a")}} PST
            </div>
          {% endfor %}
        </li>
      </ul>
    </div>

    <div class="times-selector-container">
      <ul class="d-flex list-unstyled" >
        <li class="times-selector-placeholder {% if dates %}d-none{% endif %}">
          Select dates first.
        </li>
        {% if dates %}
        {% for date in dates %}
          <li>
            <h4 class="date-label mb-0 text-center">
              {{date.date | date("D, M j")}}
            </h4>
            {% for time in time_labels %}
              {% set date_time = "#{date.date} #{time}" %}
              <input 
                {% set count = 0 %}
                {% set available_user_names = "" %}
                {% for availability in availabilities %}
                  {% if availability.start_time == date_time %}
                    {% set count = count + 1 %}
                    {% set previous_names = available_user_names %}
                    {% set available_user_names = previous_names ~ "/" ~ availability.user_name %}
                  {% endif %}
                {% endfor %}
                onmouseover="showGroupAvailability('{{date_time}}', '{{available_user_names}}');" onmouseleave="showTimeSelector()" data-available_users="{{available_user_names}}" class="times-label {% if count > 0 %}times-label--checked times-label--checked-confirm"
                style="background-color:green;opacity:{{(((count) * 100) // schedule.users_count)}}%; {% endif %}"
                
                {{time}}
              </input>
            {% endfor %}
          </li>
        {% endfor %}
        {% endif %}
      </ul>
    </div>
  </div>
</div> 

