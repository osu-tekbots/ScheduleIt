{% extends 'layouts/logged_in.twig' %}

{% block page_content %}

<div class="align-items-center d-md-flex justify-content-between">
  <h1 class="h2 mb-4">
    {{title}}
  </h1>
  {{ include('shared/_search_form.twig') }}
</div>
{% if search_term and search_result_count > 0 %}
  <p>
    Found {{search_result_count}} result{% if search_result_count != 1 %}s{% endif %} for "{{search_term}}"
  </p>
{% endif %}
{% if search_term %}
  {% if search_schedules %}
    <div class="row">
      <div class="col-lg-6 col-md-12">
        {% for schedule in search_schedules %}
          {{ include('schedule/_schedule_card.twig') }}
        {% endfor %}
      </div>
    </div>
  {% else %}
    <p>No results found</p>
  {% endif %}
{% else %}
  <nav>
    <div class="nav nav-tabs my-schedules-nav-tabs" role="tablist">
      <a class="nav-item nav-link active" id="all-schedules-tab" data-toggle="tab" href="#all-schedules" role="tab" aria-controls="all-schedules" aria-selected="false">
        All Upcoming Find-a-Times ({{ upcoming_schedules | count }})
      </a>
      {% if created_schedules %}
        <a class="nav-item nav-link" id="created-schedules-tab" data-toggle="tab" href="#created-schedules" role="tab" aria-controls="created-schedules" aria-selected="true">
          Find-a-Times Created By Me ({{ created_schedules | count }})
        </a>
      {% endif %}
      {% if past_schedules %}
        <a class="nav-item nav-link" id="past-schedules-tab" data-toggle="tab" href="#past-schedules" role="tab" aria-controls="past-schedules" aria-selected="false">
          Past Find-a-Times ({{ past_schedules | count }})
        </a>
      {% endif %}
    </div>
  </nav>
  <div class="row">
    <div class="col-lg-6">
      <div class="tab-content pt-3">
        <div class="tab-pane fade show active" id="all-schedules" role="tabpanel" aria-labelledby="all-schedules-tab">
          {% if upcoming_schedules %}
            {% for schedule in upcoming_schedules %}
              {{ include('schedule/_schedule_card.twig') }}
            {% endfor %}
          {% else %}
            <p>
              Nothing scheduled yet!
            </p>
          {% endif %}
        </div>
        {% if created_schedules %}
          <div class="tab-pane fade" id="created-schedules" role="tabpanel" aria-labelledby="created-schedules-tab">
            {% for schedule in created_schedules %}
              {{ include('schedule/_schedule_card.twig') }}
            {% endfor %}
          </div>
        {% endif %}
        {% if past_schedules %}
          <div class="tab-pane fade" id="past-schedules" role="tabpanel" aria-labelledby="past-schedules-tab">
            {% for schedule in past_schedules %}
              {{ include('schedule/_schedule_card.twig') }}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% endblock %}
