{% extends 'layouts/logged_in.twig' %}

{% block page_content %}

<h1 class="h2 mb-4">
  {{title}}
</h1>

{% if exists == 1 %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i>
        Your timezone is currently set to <b>{{user_timezone}}</b>. If you are in a
        different timezone, visit <a href="{{site_url}}/profile">your profile page</a>
        change the timezone this information is displayed in.
    </div>

    <form enctype="multipart/form-data" method="post">
    <div class="row">
        <div id="groupAvailability" class="col-lg-6" style="display: none; text-align: center;">
        <div id="groupAvailabilityDiv" class="col-lg-4">
            <h1 id="ratio_of_group_availability" class="h2 mb-4">
                
            </h1>
            <label id="time_display_group_availability" class="h6 mb-3">

            </label>
            <br>
            <div class="row">
            <div class="col-6">
                <label class="h6 mb-3">
                Available
                </label>
                <p id="available_users_group_availability">
                </p>
            </div>
            <div class="col-6">
                <label class="h6 mb-3">
                Unavailable
                </label>
                <p id="unavailable_users_group_availability">
                </p>
            </div>
            </div>
        </div>
        </div>
		<div id="myTimeSelector" class="col-lg-6 col-10" style="display: inline-block;">
            {{ include('schedule/_available_selector.twig') }}
        </div>
        <div class="col-lg-6 col-10" style="float: right;">
            {% if is_anon == 0 %}
                {{ include('schedule/_available_display.twig') }}
            {% endif %}
        </div>
    </div>
    
    <div class="pt-4">
    <button class="btn btn-success">
        Save Schedule
    </button>
    <a class="ml-3" href="{{site_url}}/meetings">
        Cancel
    </a>
    </div>

    </form>

{% endif %}

{% endblock %}
