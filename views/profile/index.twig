{% extends 'layouts/logged_in.twig' %}

{% block page_content %}

<h1 class="h2 mb-4">
  {{title}}
</h1>
<h2 class="h6">
  ONID
</h2>
<p>
  {{user_onid}}
</p>
<h2 class="h6">
  Name
</h2>
<p>
  {{user_firstname}} {{user_lastname}}
</p>
<h2 class="h6">
  Email
</h2>
<p>
  {{user_email}}
</p>

<form method="POST">
  <label for="timezone" class="h6 d-block">
    Timezone
  </label>
  <select id="timezone" name="timezone" onchange="this.form.submit()">
  {% for tz in php_timezones %}
    <option value="{{tz}}" {% if user_timezone == tz %}selected{% endif %}>{{tz}}</option>
  {% endfor %}
  </select>
</form>

{% endblock %}
