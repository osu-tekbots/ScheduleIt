<!DOCTYPE html>

<html lang="en">
  <head>
    <title>{{site_name}}</title>
    {{ include('layouts/_head.twig') }}
    {% block page_head %}
    {% endblock %}
  </head>
  <body class="body-logged-out d-flex flex-column" style="min-height: 100dvh;">
    <nav class="navbar navbar-expand-md py-0 sticky-top">
      <div class="navbar-container">
        <div class="d-flex flex-md-nowrap justify-content-between align-items-center">
          <a class="navbar-brand" href="{{site_url}}"></a>
        </div>
      </div>
    </nav>
    <main role="main" class="d-flex flex-column" style="flex-grow: 1;">
      {% block page_content %}
      {% endblock %}
    </main>
    {{ include('layouts/_footer.twig') }}
    {% block page_footer %}
    {% endblock %}
  </body>
</html>
