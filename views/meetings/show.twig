{% extends 'layouts/logged_in.twig' %}

{% block page_content %}

<h1 class="h2 mb-4">
  {{title}}
</h1>
<div class="card mb-4 card-mine">
  <div class="card-body pb-0">
    <div class="row">
      <div class="col-6">
        <h4 class="h6 mb-1">
          Title
        </h4>
        <p class="card-text-large">
          {{meeting.name}}
        </p>
        <h4 class="h6 mb-1">
          Location
        </h4>
        <p class="card-text-large">
          {{meeting.location}}
        </p>
        <h4 class="h6 mb-1">
          Description
        </h4>
        <p class="card-text-large">
          {{meeting.description}}
        </p>
        <h4 class="h6 mb-1">
          Dates
        </h4>
        <p class="card-text-large">
          {% for date in meeting.dates %}
            {% if (loop.index == 1) or (loop.index == meeting.dates_count) %}
              {% if loop.index != 1 %} to {% endif %}{{date.date | date("n/j/y")}}
            {% endif %}
          {% endfor %}
        </p>
        <h4 class="h6 mb-1">
          Anonymous Meeting
        </h4>
        <p class="card-text-large">
          {% if meeting.is_anon == true %}
            Yes
          {% else %}
            No
          {% endif %}
        </p>
      </div>
      <div class="col-6">
        <h4 class="h6 mb-1">
          Allow Attendees to Include Messages
        </h4>
        <p class="card-text-large">
          {% if meeting.enable_message == true %}
            Yes
          {% else %}
            No
          {% endif %}
        </p>
        {% if meeting.enable_message == true %}
          <h4 class="h6 mb-1">
            Require Attendees to Include Messages
          </h4>
          <p class="card-text-large">
            {% if meeting.require_message == true %}
              Yes
            {% else %}
              No
            {% endif %}
          </p>
        {% endif %}
        <h4 class="h6 mb-1">
          Allow Attendees to Upload Files
        </h4>
        <p class="card-text-large">
          {% if meeting.enable_upload == true %}
            Yes
          {% else %}
            No
          {% endif %}
        </p>
        {% if meeting.enable_upload == true %}
          <h4 class="h6 mb-1">
            Require Attendees to Upload Files
          </h4>
          <p class="card-text-large">
            {% if meeting.require_upload == true %}
              Yes
            {% else %}
              No
            {% endif %}
          </p>
        {% endif %}
        <h4 class="h6 mb-1">
          File Download for Attendees
        </h4>
        <p class="card-text-large">
          {% if meeting.creator_file %}
            <a href="{{uploads_url}}{{meeting.creator_file}}" download="">
              {{meeting.creator_file | basename}}
            </a>
          {% else %}
            N/A
          {% endif %}
        </p>
        <p class="card-text-large">
          <a id="inviteLink" class="align-middle" href="{{site_url}}/invite?key={{meeting.hash}}">Invite Link</a>
          <button class="btn btn-outline-secondary btn-sm copy-btn ml-2" data-link="{{site_url}}/invite?key={{meeting.hash}}">
            <i class="fas fa-clipboard"></i> Copy
          </button>
        </p>
      </div>
    </div>
  </div>
</div>
<p class="mb-5">
  <a class="btn btn-primary" href="{{site_url}}/meetings/{{meeting.id}}/edit">
    <i class="fas fa-pencil-alt"></i>
    Edit Meeting Info
  </a>
  <a class="btn btn-primary ml-3" href="{{site_url}}/meetings/{{meeting.id}}/dates">
    <i class="fas fa-calendar-alt"></i>
    Edit Meeting Dates
  </a>
  <button class="btn btn-outline-danger ml-3" data-toggle="modal" data-target="#delete-meeting-modal" type="button">
    <i class="fas fa-trash"></i>
    Delete Meeting
  </button>
</p>
<div class="d-flex align-items-center justify-content-between">
  <h2 class="h3">
    Attendees
  </h2>
  <form method="post">
    <input name="attendee_csv" value="1" type="hidden">
    <button class="btn btn-sm btn-primary" type="submit">
      <i class="fas fa-file-csv"></i>
      Save as CSV
    </button>
  </form>
</div>
{% if attendee_meetings %}
  <table class="table">
    <tr class="d-flex">
      <th class="col">Date</th>
      <th class="col">Time</th>
      <th class="col">Name</th>
      {% if meeting.enable_message == true %}
        <th class="col-2">Message</th>
      {% endif %}
      {% if meeting.enable_upload == true %}
        <th class="col-2">Uploaded File</th>
      {% endif %}
      <th class="col-2" style="text-align:center;">
        <form method="post">
          <input name="ics" value="1" type="hidden">
          <button type="submit" class="btn btn-secondary btn-sm">
            Download ICS
          </button>
        </form>
      </th>
      <th class="col-1">Remove</th>
    </tr>

    {# Need to track previous meeting for detecting multiple people signed up for same time slot #}
    {% set previous = false %}
    {% for a_meeting in attendee_meetings %}
      <tr class="d-flex">
        {% if (previous == false or previous.start_time != a_meeting.start_time) %}
          <td class="col">
            {{a_meeting.start_time | date("D, F j, Y", user_timezone)}}
          </td>
          <td class="col">
            {{a_meeting.start_time| date("g:ia", user_timezone)}}-{{a_meeting.end_time| date("g:ia T (\\G\\M\\T P)", user_timezone)}}
          </td>
        {% else %}
          <td class="col border-top-0"></td>
          <td class="col border-top-0"></td>
        {% endif %}
        <td class="col">
          <a href="mailto:{{a_meeting.attendee_email}}">{{a_meeting.attendee_name}}</a>
        </td>
        {% if meeting.enable_message == true %}
          <td class="col-2">
            {% if a_meeting.message %}
              {{a_meeting.message}}
            {% else %}
              N/A
            {% endif %}
          </td>
        {% endif %}
        {% if meeting.enable_upload == true %}
          <td class="col-2">
            {% if a_meeting.attendee_file %}
              <a href="{{uploads_url}}{{a_meeting.attendee_file}}" download="">{{a_meeting.attendee_file | basename}}</a>
            {% else %}
              N/A
            {% endif %}
          </td>
        {% endif %}

        <td class="col-2" style="text-align:center;">
          {% if (previous == false or previous.start_time != a_meeting.start_time) %}
            <a href="{{a_meeting.google_cal_link}}" target="_blank" class="btn-googlelink">
              
            </a>
            <a href="{{a_meeting.outlook_cal_link}}" target="_blank"  class="btn-outlooklink">

            </a>
          {% endif %}
        </td>

        <td class="col-1" style="text-align:center;">
          <button
            class="btn btn-danger btn-sm table-btn"
            data-timeslot-hash="{{a_meeting.timeslot_hash}}"
            data-attendee-onid="{{a_meeting.attendee_onid}}"
            data-url="{{site_url}}/meetings/remove_attendee"
            type="button"
          >
            <i class="fas fa-times"></i>
          </button>
        </td>
      </tr>
      {% set previous = a_meeting %}
    {% endfor %}
  </table>
  <div class="modal fade" id="delete-attendee-modal" tabindex="-1" role="dialog" aria-labelledby="delete-attendee-modal-label" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="delete-attendee-modal-label">Remove Attendee</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          Are you sure you want to remove this attendee?
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger" id="delete-attendee-button">Delete</button>
        </div>
      </div>
    </div>
  </div>
{% else %}
  <p>
    No attendees have signed up yet.
  </p>
{% endif %}
{% if invite_list %}
  <h2 class="h3 mt-4">
    Unregistered Invitees
  </h2>
  <table class="table">
    <tr class="d-flex">
      <th class="col-6">ONID</th>
      <th class="col-6">Date Sent</th>
    </tr>
    {% for list in invite_list %}
      <tr class="d-flex">
        <td class="col-6">
          {{ list.user_onid }}
        </td>
        <td class="col-6">
          {{ list.mod_date | date("n/j/y g:ia T (\\G\\M\\T P)", user_timezone)}}
        </td>
      </tr>
    {% endfor %}
  </table>
{% endif %}
<p class="mb-5">
  <button class="btn btn-primary" data-toggle="modal" data-target="#invite-attendees-modal" type="button">
    Invite Attendees
  </button>
</p>
<h2 class="h3 mt-4">
  Collaborators
</h2>
{% if collaborator_list %}
  <table class="table">
    <tr class="d-flex">
      <th class="col-6">Name</th>
      <th class="col-5">Date Added</th>
      <th class="col-1">Remove</th>
    </tr>
    {% for collaborator in collaborator_list %}
      <tr class="d-flex">
        <td class="col-6">
          {{ collaborator.user_name }}
        </td>
        <td class="col-5">
          {{ collaborator.date_added | date("n/j/y g:ia T (\\G\\M\\T P)", user_timezone)}}
        </td>
        <td class="col-1" style="text-align: center;">
          <form method="post">
            <input type="hidden" name="removeCollaborator" value="{{ collaborator.user_id }}">
            <button
              class="btn btn-danger btn-sm"
              type="submit"
            >
              <i class="fas fa-times"></i>
            </button>
          </form>
        </td>
      </tr>
    {% endfor %}
  </table>
{% endif %}
<p class="mb-5 mt-3">
  <button class="btn btn-primary" data-toggle="modal" data-target="#add-collaborators-modal" type="button">
    Add Collaborator
  </button>
</p>
<div class="modal fade" id="invite-attendees-modal" tabindex="-1" role="dialog" aria-labelledby="invite-attendees-modal-label" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="invite-attendees-modal-label">Invite Attendees</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form method="post">
        <div class="modal-body">
          <p>
            Please enter ONIDs (without the email suffix "@oregonstate.edu") separated by spaces.
          </p>
          <div class="form-group">
            <input class="form-control" name="attendeeOnid" id="onid" placeholder="onid1 onid2..." type="text">
          </div>
        </div>
        <div class="modal-footer">
          <input type="hidden" name="link" value="{{site_url}}/invite?key={{meeting.hash}}">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button class="btn btn-success">Send Invites</button>
        </div>
      </form>
    </div>
  </div>
</div>
<div class="modal fade" id="add-collaborators-modal" tabindex="-1" role="dialog" aria-labelledby="add-collaborators-modal-label" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="add-collaborators-modal-label">Add Collaborators</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form method="post">
        <div class="modal-body">
          <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            Collaborators can view and edit the meeting but will only be shown as an
            attendee for timeslots they sign up for.
          </div>
          <p>
            Please enter the collaborator's ONID (without the email suffix "@oregonstate.edu").
          </p>
          <div class="form-group">
            <input class="form-control" name="collaboratorOnid" id="onid" type="text">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Add Collaborator</button>
        </div>
      </form>
    </div>
  </div>
</div>
<div class="modal fade" id="delete-meeting-modal" tabindex="-1" role="dialog" aria-labelledby="delete-meeting-modal-label" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="delete-meeting-modal-label">Delete Meeting</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete this meeting?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <form method="post">
          <input type="hidden" name="deleteHash" value="{{meeting.hash}}">
          <button class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

{% endblock %}
