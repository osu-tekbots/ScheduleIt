{% extends 'layouts/logged_out.twig' %}

{% block page_content %}

<div class="jumbotron jumbotron-fluid">
  <div class="container">
    <h1 class="display-md-4"
      >Welcome to {{site_name}}
    </h1>
    <p class="lead">
      {{site_name}} is a meeting scheduling service that is available to anyone in the Oregon State
      University community. No registration is necessary. Sign in with your OSU email to get started.
    </p>
    <p class="lead">
      <a class="btn btn-lg btn-primary" href="{{site_url}}/login">
        Login
      </a>
    </p>
    <p>
      Schedule-It has helped {{stats.meeting_users}} users book {{stats.meeting_appointments}}
      appointments for {{stats.meetings}} events and helped {{stats.find_a_time_users}}
      users find the best time to meet for {{stats.find_a_times}} meetings. To date, it
      has served {{stats.users}} people at Oregon State University.
    </p>
  </div>
</div>

{% endblock %}
