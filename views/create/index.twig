{% extends 'layouts/logged_in.twig' %}

{% block page_content %}

<h1 class="h2 mb-4">
  {{title}}
</h1>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card card-mine h-100">
            <div class="card-body d-flex flex-column align-items-start">
                <h2 class="h4 card-title">Meeting</h2>
                <p class="card-text">
                    Meetings allow you to set up appointments for other people to meet
                    with you. Optionally, you can ask participants to respond to a prompt
                    with text or a file upload when they sign up.
                </p>
                <a class="btn btn-primary mt-auto" href="{{site_url}}/meetings/create">
                    Create Meeting
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card card-mine h-100">
            <div class="card-body d-flex flex-column align-items-start">
                <h2 class="h4 card-title">Find-A-Time</h2>
                <p class="card-text">
                    Find-a-times allow anyone with the link to enter their availability to
                    find possible times to meet.
                </p>
                <a class="btn btn-primary mt-auto" href="{{site_url}}/schedule/create">
                    Create Find-A-Time
                </a>
            </div>
        </div>
    </div>
</div>

{% endblock %}
